# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=mydb

# Instagram API Credentials (Replace with NEW credentials)
INSTAGRAM_APP_ID=YOUR_NEW_APP_ID
INSTAGRAM_APP_SECRET=YOUR_NEW_APP_SECRET
INSTAGRAM_REDIRECT_URI=YOUR_APP_REDIRECT_URI # e.g., http://localhost:5000/auth/instagram/callback

# JWT Secret Key (Generate a strong random key)
JWT_SECRET_KEY=YOUR_STRONG_RANDOM_SECRET_KEY

